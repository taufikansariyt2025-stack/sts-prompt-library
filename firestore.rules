rules_version = '2';

/**
 * STS Prompt Library — Firestore security rules.
 *
 * Posture: NO client may read or write ANY collection. Everything is denied.
 *
 * This is not laziness — it is the point. The library is gated behind an
 * approved account, and every read the app performs runs server-side through
 * the Firebase Admin SDK (which bypasses these rules) after `requireSession()`
 * has verified the caller.
 *
 * Why a blanket deny matters here: the Firebase web config in the client bundle
 * is public by design. If these rules allowed `read: if resource.data.status ==
 * 'published'`, anyone could take that config, query Firestore directly, and
 * pull every prompt — completely bypassing the sign-in gate. The UI gate is
 * only as strong as these rules.
 *
 * The browser Firebase SDK is used for Authentication ONLY. It never reads
 * Firestore. See lib/firebase/client.ts.
 *
 * Tested in tests/rules/. Any change here requires a test.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Prompt content — server-side reads only, after an auth check.
    match /prompts/{promptId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read, write: if false;
    }

    match /tags/{tagId} {
      allow read, write: if false;
    }

    // Branding and site copy. Rendered server-side into the page.
    match /settings/{docId} {
      allow read, write: if false;
    }

    // Internal registries.
    match /media/{mediaId} {
      allow read, write: if false;
    }

    match /auditLog/{entryId} {
      allow read, write: if false;
    }

    // Access requests and roles. A client being able to write here would let
    // anyone approve themselves.
    match /users/{uid} {
      allow read, write: if false;
    }

    match /metrics/{docId} {
      allow read, write: if false;
    }

    // Default deny — belt and braces for any collection added later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
