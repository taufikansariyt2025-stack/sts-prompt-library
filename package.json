{
  "name": "sts-prompt-library",
  "version": "0.1.0",
  "private": true,
  "description": "STS Prompt Library — AI image & video prompts, each shown with its real output.",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "vitest run tests/rules",
    "analyze": "ANALYZE=true next build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "seed": "tsx scripts/seed.ts",
    "extract:docx": "tsx scripts/extract-docx.ts",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "gen:icons": "tsx scripts/generate-icons.ts",
    "set:admin": "tsx scripts/set-admin-claim.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1104.0",
    "@aws-sdk/s3-request-presigner": "3.1104.0",
    "@hookform/resolvers": "5.7.1",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.17.1",
    "firebase-admin": "14.2.0",
    "idb": "8.0.3",
    "lucide-react": "1.28.0",
    "minisearch": "7.2.0",
    "motion": "13.0.0",
    "nanoid": "6.0.1",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "sharp": "0.35.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@next/bundle-analyzer": "16.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fflate": "^0.8.3",
    "jsdom": "30.0.1",
    "only-allow": "1.2.2",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.9",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
