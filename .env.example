# ─────────────────────────────────────────────────────────────────────────────
# STS Prompt Library — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment (Dokploy Compose only) ────────────────────────────────────────
# The domain Traefik routes to. No scheme, no trailing slash.
DOMAIN=prompts.example.com

# ── Public — safe to expose in the client bundle ─────────────────────────────
# ⚠ These are BUILD-TIME. Next inlines them into the browser bundle during
#   `docker build`, so changing one needs a rebuild, not just a restart.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web config. These are public identifiers, not secrets —
# Firestore security rules are what actually enforce access.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server only — NEVER prefix any of these with NEXT_PUBLIC_ ────────────────

# Firebase service account JSON. Raw JSON or base64-encoded JSON both work;
# base64 is safer to paste into hosting env UIs (no newline mangling).
#   macOS:  base64 -i service-account.json | pbcopy
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cloudflare R2
# ── Cloudflare R2 (image uploads) ────────────────────────────────────────────
# No public bucket, no custom domain, no CORS needed. Media is stored privately
# and served through /api/media behind a session check.
#
# Cloudflare dashboard → R2 → create a bucket, then
# R2 → Manage API tokens → create a token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sts-prompt-library-media

