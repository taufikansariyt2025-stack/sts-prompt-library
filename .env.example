# ─────────────────────────────────────────────────────────────────────────────
# STS Prompt Library — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public — safe to expose in the client bundle ─────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# R2 bucket bound to a custom domain (never the r2.dev URL)
NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# Firebase web config. These are public identifiers, not secrets —
# Firestore security rules are what actually enforce access.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server only — NEVER prefix any of these with NEXT_PUBLIC_ ────────────────

# Firebase service account JSON. Raw JSON or base64-encoded JSON both work;
# base64 is safer to paste into hosting env UIs (no newline mangling).
#   macOS:  base64 -i service-account.json | pbcopy
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sts-prompt-library-media
R2_PUBLIC_URL=https://cdn.example.com

# Comma-separated emails allowed to hold the admin claim.
# Run `pnpm set:admin <email>` after the account exists in Firebase Auth.
ADMIN_EMAILS=you@example.com

# Rate limiting (optional in dev — falls back to an in-memory limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Guards the on-demand revalidation webhook. Generate with:
#   node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
REVALIDATE_SECRET=
